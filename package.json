{
  "name": "otbor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "server": "bun packages/cloud/src/server.ts",
    "worker": "bun packages/cloud/src/worker.ts",
    "cli": "bun packages/cli/src/main.ts",
    "web": "bun run --cwd apps/web dev",
    "extension:build": "bun run --cwd apps/extension build",
    "extension:install": "bun packages/cli/src/main.ts extension install --browser zen",
    "extension:dev": "bun packages/cli/src/main.ts extension dev",
    "web:build": "bun run --cwd apps/web build",
    "mcp": "bun packages/mcp/src/main.ts",
    "dev": "bun packages/cli/src/main.ts up",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:studio": "docker compose --profile studio up -d drizzle-studio",
    "db:migrate": "bun run cli db migrate",
    "db:reset": "bun run cli db reset",
    "db:seed": "bun run cli db seed",
    "link": "cd packages/cli && bun link",
    "test": "bun test",
    "test:integration": "OTBOR_TEST_DATABASE_URL=${OTBOR_TEST_DATABASE_URL:-postgres://otbor:otbor@localhost:55432/postgres} bun test packages/cloud/test/integration",
    "typecheck": "tsc -p tsconfig.json && bun run --cwd apps/web typecheck && bun run --cwd apps/extension typecheck",
    "up": "bun packages/cli/src/main.ts up",
    "down": "bun packages/cli/src/main.ts down",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^24.0.0",
    "effect": "4.1.0",
    "oxlint": "^1.91.0",
    "oxlint-plugin-effect": "^0.32.1",
    "typescript": "6.0.3"
  }
}
