{
  "name": "@otbor/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b chrome && wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@otbor/contract": "workspace:*",
    "@otbor/crawler": "workspace:*",
    "@otbor/hh": "workspace:*",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "typescript": "6.0.3",
    "wxt": "^0.20.0"
  }
}
