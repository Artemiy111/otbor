# Postgres 18 (see docker-compose.yml)
DATABASE_URL=postgres://otbor:otbor@localhost:55432/otbor

# Runtime role used after `SET LOCAL ROLE`; the owner role is only for migrations.
DATABASE_RUNTIME_ROLE=otbor_runtime

# Local single-user mode. When set, every request is scoped to this user id and
# no authentication is required. Leave empty to require an authenticated user.
BOOTSTRAP_USER_ID=local-user

# RPC HTTP server
PORT=3001
HOST=127.0.0.1

# Web UI (`bun run web`). During development `/rpc` is proxied to this server,
# so an empty value means http://127.0.0.1:3001/rpc. A built bundle can use the
# full URL directly.
# OTBOR_API_URL=http://127.0.0.1:3001/rpc

# Worker loops, in seconds. The scheduler claims due crawl schedules on each
# tick and advances next_run_at before the crawl starts.
WORKER_SWEEP_SECONDS=15
WORKER_SCHEDULE_SECONDS=60

# Logs
LOG_DIR=./logs

# Device token printed once by `otbor harness register`. Prefer --token for a
# one-off call; set this only on the machine running the harness.
# OTBOR_HARNESS_TOKEN=

# Crawler proxy. Either a ready HTTP proxy (Clash Verge, corporate gateway)
# or a subscription URL that mihomo pulls inside Docker. Prefer
# `otbor proxy set` so the secret is not stored in .env.
# OTBOR_PROXY_URL=http://127.0.0.1:7897
# OTBOR_PROXY_SUB_URL=https://sub.example.com/token
# OTBOR_PROXY_ROTATE=captcha
# OTBOR_PROXY_MAX_ROTATIONS=3

# SystemOne: local decision model (omlx) that analyses vacancies. The key is a
# secret and is never logged.
# OTBOR_SYSTEMONE_ENABLED=false   # выключить анализ вакансий целиком (по умолчанию true)
# OTBOR_SYSTEMONE_URL=http://127.0.0.1:1111
# OTBOR_SYSTEMONE_API_KEY=
# OTBOR_SYSTEMONE_MODEL=clef-flash-4bit
# OTBOR_SYSTEMONE_TIMEOUT_MS=60000
