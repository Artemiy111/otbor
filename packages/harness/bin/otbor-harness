#!/bin/sh
# Stable entry point for the edge harness. Resolves symlinks so `bun link`
# can put this file in ~/.bun/bin without breaking the relative import.
set -eu

SELF=$0
while [ -h "$SELF" ]; do
  DIR=$(CDPATH= cd -P "$(dirname "$SELF")" && pwd)
  LINK=$(readlink "$SELF")
  case "$LINK" in
    /*) SELF=$LINK ;;
    *) SELF=$DIR/$LINK ;;
  esac
done

DIR=$(CDPATH= cd -P "$(dirname "$SELF")" && pwd)
exec bun "$DIR/../src/main.ts" "$@"
