{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@otbor/contract": ["./packages/contract/src/index.ts"],
      "@otbor/domain": ["./packages/domain/src/index.ts"],
      "@otbor/hh": ["./packages/hh/src/index.ts"],
      "@otbor/crawler": ["./packages/crawler/src/index.ts"],
      "@otbor/acp": ["./packages/acp/src/index.ts"],
      "@otbor/harness": ["./packages/harness/src/index.ts"],
      "@otbor/telegram": ["./packages/telegram/src/index.ts"],
      "@otbor/mail": ["./packages/mail/src/index.ts"],
      "@otbor/cloud": ["./packages/cloud/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.vue"
  ],
  "exclude": ["node_modules", "dist", "apps/web"]
}
